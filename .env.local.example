# =============================================================================
# LINE Messaging API
# LINE Developers コンソール > チャネル設定 > チャネルシークレット
# =============================================================================

# Webhook 受信時の署名検証に使用するシークレットキー
LINE_CHANNEL_SECRET=

# メッセージ送信（Reply API / Push API）に使用するアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=


# =============================================================================
# Claude API (Anthropic)
# https://console.anthropic.com/ で発行
# =============================================================================

# AI 応答生成に使用する API キー
ANTHROPIC_API_KEY=


# =============================================================================
# Supabase
# Supabase ダッシュボード > Project Settings > API で確認
# =============================================================================

# Supabase プロジェクトの URL（クライアントサイドでも使用）
NEXT_PUBLIC_SUPABASE_URL=

# 匿名アクセス用の公開キー（クライアントサイドでも使用可）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 管理者権限キー — サーバーサイド専用。絶対にクライアントに露出させないこと
SUPABASE_SERVICE_ROLE_KEY=
